# Database (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Optional: Force Prisma migration deployment during Vercel preview/local builds.
# Only enable when the build targets a safe, isolated database.
# SPARTAN_RUN_MIGRATIONS_ON_BUILD="false"

# Auth.js Configuration
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Email Service
# EMAIL_PROVIDER selects the transport: "ses" (AWS SES, recommended),
# "mailchimp" (legacy Mailchimp Transactional), or "log" (dev only — prints
# instead of sending). When unset, the provider is inferred from credentials
# (MAILCHIMP_API_KEY -> mailchimp, AWS_REGION -> ses) and falls back to "log";
# unconfigured production sends fail loudly at send time, never at boot.
# EMAIL_PROVIDER="ses"
# SES: set AWS_REGION below and provide AWS credentials via the standard env
# vars (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or Vercel's AWS integration.
# Mailchimp: get an API key from https://mandrillapp.com/settings
MAILCHIMP_API_KEY=""
EMAIL_FROM="noreply@spartan.arkhins.com"

# Cron job authentication (required when cron endpoints are enabled)
# Generate with: openssl rand -base64 32
# CRON_SECRET=""

# Platform administrators (bootstrap allowlist)
# Comma-separated emails granted platform-admin rights (approving/rejecting
# signups, listing users) without a manual DB write. Non-self-grantable.
# Persistent grants can also be set via the User.isPlatformAdmin column.
# PLATFORM_ADMIN_EMAILS="you@example.com"

# Protected uptime/readiness checks
# Set the same generated value in Vercel and GitHub Actions secrets.
# Generate with: openssl rand -base64 32
# UPTIME_CHECK_TOKEN=""

# Analytics and Tracking
# Umami Analytics (privacy-friendly, open-source)
# Get your website ID from: https://cloud.umami.is
# Leave empty to disable Umami tracking
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Google Analytics 4 Measurement ID
# Leave empty to disable GA4. The app respects browser Do Not Track/GPC and stored denial consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional: Error tracking (Sentry)
# Set NEXT_PUBLIC_SENTRY_DSN to enable client/server error capture.
# SENTRY_ORG + SENTRY_PROJECT + SENTRY_AUTH_TOKEN additionally enable
# source-map upload at build time (upload is skipped without the token).
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Optional: Performance monitoring
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Optional: Scheduled uptime monitoring workflow targets
# DOCS_PAGES_DOMAIN="docs.spartan.arkhins.com"
# Format: comma-separated URLs or name=url pairs. Defaults to public main and docs sites locally.
# The GitHub Actions workflow also checks the protected health endpoint.
# UPTIME_CHECK_URLS="main=https://spartan.arkhins.com,docs=https://docs.spartan.arkhins.com,health=https://spartan.arkhins.com/api/health"
# UPTIME_CHECK_AUTH_TARGETS="health"
# UPTIME_CHECK_AUTH_ALLOWED_HOSTS="spartan.arkhins.com,docs.spartan.arkhins.com"
# UPTIME_CHECK_TIMEOUT_MS="10000"

# Marketing and Conversion Tracking
# Session recording is intentionally not enabled by default; choose/configure a vendor only with a consent policy.
# NEXT_PUBLIC_HOTJAR_ID=""
# NEXT_PUBLIC_MIXPANEL_TOKEN=""

# Optional: For future AWS migration
# AWS_REGION="us-east-1"

# Object storage (optional — document filing and event galleries are disabled
# when nothing below is set). STORAGE_PROVIDER picks the backend; when unset it
# is inferred from credentials (S3_BUCKET -> s3, BLOB_READ_WRITE_TOKEN -> vercel-blob).
#
# Recommended: a PRIVATE S3 bucket (block all public access). Uploads go straight
# from the browser to the bucket on a 60-second presigned PUT, and every read is a
# short-lived signed URL minted after an authorization check — so paperwork such
# as medical certificates is never reachable by guessing a link.
# Credentials use the standard AWS chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# an instance role, or Vercel's AWS OIDC integration). The bucket needs a CORS rule
# allowing PUT and GET from your NEXTAUTH_URL origin.
# STORAGE_PROVIDER="s3"
# S3_BUCKET="spartan-uploads"
# S3_REGION="us-east-1"            # falls back to AWS_REGION
# Any S3-compatible store works (Cloudflare R2, MinIO, Backblaze B2):
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"       # MinIO and most self-hosted gateways
#
# Alternative: Vercel Blob (objects are public-but-unguessable, not private).
# STORAGE_PROVIDER="vercel-blob"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Payments: Stripe Connect (optional — rink session purchasing)
# When unset, paid registration falls back to free opt-in and checkout is disabled.
# Each rink connects its own Stripe account; Spartan uses direct charges.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Connect webhook signing secret (events from connected accounts) — see app/api/webhooks/stripe
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
# Optional platform application fee in basis points (250 = 2.5%). Default 0.
# STRIPE_PLATFORM_FEE_BPS="0"
